# ═══════════════════════════════════════════════════════════════
# «بسلامت» — نمونهٔ متغیرهای محیطی
# لوکال: این فایل را به .env کپی کنید | ورسل: در Dashboard تنظیم کنید
# ═══════════════════════════════════════════════════════════════

# دیتابیس ────────────────────────────────────────────────────────
# لوکال (SQLite) — نسبت به prisma/schema.prisma:
DATABASE_URL=file:../db/custom.db
# تولید روی ورسل (پیشنهاد: Neon/Turso) — مثال:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# احراز هویت OTP ─────────────────────────────────────────────────
# Pepper هش کد (در تولید حتماً مقدار تصادفی ۳۲+ کاراکتری)
OTP_PEPPER=
# مهلت اعتبار کد (ثانیه) — پیش‌فرض ۱۲۰
OTP_TTL_SECONDS=120
# کد دموی ثابت (فاز تست) — خاموش‌کردن: OTP_DEMO_MODE=false
OTP_DEMO_MODE=true
OTP_DEMO_CODE=12345
# حالت توسعهٔ پیامک (کد در پاسخ API برمی‌گردد)
SMS_DEV_MODE=true

# پنل مدیریت ─────────────────────────────────────────────────────
# شماره‌های مجاز ورود ادمین، جدا با کاما
ADMIN_PHONES=09120000000

# پیامک ──────────────────────────────────────────────────────────
SMS_DRIVER=console
# KAVENEGAR_API_KEY=
# SMSIR_API_KEY=
# MELLIPAYAMAK_USERNAME=

# ایمیل ──────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="بسلامت <no-reply@example.com>"
